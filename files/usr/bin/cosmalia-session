#!/bin/sh
# Cosmalia — a minimal COSMIC-based Wayland desktop in under 1 GB of RAM.
# Source: https://github.com/grigio/cosmalia-session
# (installed by the cosmalia-session package; edit the source, not
# the copy in /usr/bin)
# The compositor is cosmic-comp (macOS traffic-light decorations,
# wlr-foreign-toplevel, 3-finger workspace swipe, in-process Alt+Tab); the
# shell is Noctalia.
# XDG session entry: /usr/share/wayland-sessions/cosmalia.desktop
# dinit user target: /etc/dinit.d/user/cosmalia-session.target
#
# What runs, and nothing else:
#   cosmic-comp                     compositor, started here (it must run
#                                   before the socket and the session target)
#   noctalia                        bar, dock, launcher, notifications, lock
#                                   screen, idle/suspend, polkit agent, MPRIS,
#                                   screensaver; supervised by dinit
#   cosmic-settings-daemon          cosmic-config watchers; supervised
#   xdg-desktop-portal + COSMIC impl (D-Bus activated; stale ones are stopped
#                                     below, see the comment)
# Already covered without starting anything here:
#   dbus-daemon                     user bus
#   pipewire / wireplumber          socket + enabled unit (audio, screencast)
#   gnome-keyring-daemon            secret service, socket activated
#   gvfs-*, xdg-document-portal     D-Bus activated on first use, if installed
#   upower, power-profiles-daemon   system services, session agnostic
#
# Noctalia and cosmic-settings-daemon are user services, not children of this
# script: dinit restarts them if they crash, stops them with the session
# target, and writes their output to the journal (so the runtime log below
# cannot grow for the whole session).

export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=cosmalia
# The ":COSMIC" entry makes xdg-desktop-portal match cosmic.portal (UseIn=COSMIC)
# for FileChooser/Settings/Access/RemoteDesktop. The leading "cosmalia" name
# selects /usr/share/xdg-desktop-portal/cosmalia-portals.conf, which routes
# ScreenCast/Screenshot to the wlr backend (OBS screen capture).
export XDG_CURRENT_DESKTOP=cosmalia:COSMIC
# Keep the user's local bin first for the apps Noctalia spawns, but resolve
# the session binaries below by absolute path so ~/.local/bin cannot shadow
# the compositor or the shell.
export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"

if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi
if [ ! -d "$XDG_RUNTIME_DIR" ]; then
    echo "cosmalia: XDG_RUNTIME_DIR ($XDG_RUNTIME_DIR) does not exist" >&2
    echo "cosmalia: start this session from a logind login, not from a bare console" >&2
    exit 1
fi
export XDG_RUNTIME_DIR

log="$XDG_RUNTIME_DIR/cosmalia-session.log"
: >"$log"   # per-session log; the daemons themselves log to the journal

say() { echo "cosmalia: $*" >>"$log"; }

# Escape hatch for real-hardware debugging: boot with "cosmalia.shell=1" on
# the kernel command line (the ISO ships a GRUB/syslinux entry for it) and
# this session drops to a text shell instead of starting the compositor.
# The runtime log then stays readable even when a GPU produces no output.
case " $(cat /proc/cmdline 2>/dev/null) " in
    *" cosmalia.shell=1 "*|*" cosmalia.shell "*)
        say "cosmalia.shell requested: opening a text console instead of the compositor"
        exec /bin/bash -i
        ;;
esac

comp=/usr/bin/cosmic-comp
noctalia=/usr/bin/noctalia
settingsd=/usr/bin/cosmic-settings-daemon
for bin in "$comp" "$noctalia" "$settingsd"; do
    if [ ! -x "$bin" ]; then
        say "error: $bin is missing or not executable"
        echo "cosmalia: $bin is missing or not executable, see $log" >&2
        exit 1
    fi
done

# The cosmic-comp package provides /usr/bin/cosmic-comp. Warn
# instead of refusing to log in if the traffic-light decorations are missing.
if ! /usr/bin/pacman -Qq cosmic-comp >/dev/null 2>&1; then
    say "warning: cosmic-comp is not installed"
fi

# cosmic-comp picks its backend from the environment (src/backend/mod.rs):
# COSMIC_BACKEND wins; otherwise a set DISPLAY or WAYLAND_DISPLAY means
# "nested" (it tries x11, then winit) and only a clean environment means
# DRM/KMS. Leaving either set makes it try winit and die with
# "EventLoopCreation(NoCompositor)", so clear both.
if [ -z "${COSMIC_BACKEND:-}" ]; then
    unset WAYLAND_DISPLAY DISPLAY
fi

# A previous session may have left services running. Stop the session target
# and any stale portals before starting fresh.
if /usr/bin/dinitctl --user is-started cosmalia-session.target 2>/dev/null; then
    say "stopping stale cosmalia-session.target from a previous session"
    /usr/bin/dinitctl --user stop cosmalia-session.target >>"$log" 2>&1 || true
fi

stamp="$XDG_RUNTIME_DIR/.cosmalia-session-start"

# ---------------------------------------------------------------------------
# Real hardware vs. the QEMU test rig — the fix for "black screen on AMD/Intel".
#
# On real machines this is a live USB, so:
#   * the GPU driver (i915 / xe / amdgpu) is loaded asynchronously by udev,
#     and /dev/dri can still be empty when greetd autologins;
#   * simpledrm is built into the kernel and owns /dev/dri/card0 (the EFI
#     framebuffer) until the real driver takes over. cosmic-comp would be
#     happy to drive that card and draw to a screen nobody ever sees.
# QEMU's QXL/virtio GPU needs no firmware and is present from the start,
# which is why the old launcher worked there but produced a black screen on
# physical hardware.
#
# Wait briefly for a card with a real driver, and set cosmic-comp's
# COSMIC_DRM_BLOCK_DEVICES to skip any simpledrm card that is still around.
# ---------------------------------------------------------------------------
probe_drm() {
    real_card=""
    real_drv=""
    blocked=""
    for drm in /sys/class/drm/card[0-9]*; do
        [ -e "$drm" ] || continue
        card=${drm##*/}
        drv=$(readlink -f "$drm/device/driver" 2>/dev/null)
        drv=${drv##*/}
        case "$drv" in
            # simpledrm is a platform driver: the sysfs driver name is
            # "simple-framebuffer", not "simpledrm". Check both names.
            simpledrm|simple-framebuffer)
                # cosmic-comp resolves the blocklist against the render node,
                # so a bare "cardN" name can silently fail to match. Include
                # the major:minor from sysfs as well (accepted format).
                devid=$(cat "$drm/dev" 2>/dev/null)
                blocked="${blocked:+$blocked,}$card"
                [ -z "$devid" ] || blocked="$blocked,$devid"
                ;;
            '')
                : ;;  # card exists but has no bound driver yet
            *)
                [ -n "$real_card" ] || { real_card=$card; real_drv=$drv; }
                ;;
        esac
    done
}

i=0
while [ "$i" -lt 200 ]; do
    probe_drm
    [ -n "$real_card" ] && break
    i=$((i + 1))
    sleep 0.1
done
if [ -n "$blocked" ]; then
    export COSMIC_DRM_BLOCK_DEVICES="$blocked"
    say "ignoring firmware-framebuffer DRM cards: $blocked"
else
    unset COSMIC_DRM_BLOCK_DEVICES
fi
if [ -n "$real_card" ]; then
    say "DRM ready: $real_card (${real_drv:-unknown driver}) after $i checks"
else
    say "warning: no non-simpledrm card after 20s; trying the compositor anyway"
fi

# On logout the session scope SIGTERMs this script, and even a plain
# "kill <script>" should not leave the shell and the portals behind.
cleanup() {
    # Stopping cosmalia-session.target stops noctalia and
    # cosmic-settings-daemon: they are pulled in by the target's depends-ms,
    # so dinit stops them again when the target stops. Blocking (with a
    # timeout) gives them a chance to exit before logind tears down the scope.
    /usr/bin/timeout 10 /usr/bin/dinitctl --user stop cosmalia-session.target \
        >>"$log" 2>&1 || true
    # The portals are D-Bus activated, not dinit services: there is no unit
    # to stop. Kill the user's portal processes so a logout cannot leave a
    # cosmic/gtk backend behind with a stale WAYLAND_DISPLAY.
    /usr/bin/pkill -u "$USER" -f '^/usr/lib/xdg-desktop-portal' \
        >>"$log" 2>&1 || true
}
trap 'cleanup; [ -n "${comp_pid:-}" ] && kill "$comp_pid" 2>/dev/null; exit 143' TERM INT HUP

# Wait for the socket the compositor listens on (it picks wayland-N itself):
# Noctalia and everything it spawns has to be pointed at that one.
wait_for_socket() {
    sock=""
    i=0
    while [ "$i" -lt 150 ] && kill -0 "$comp_pid" 2>/dev/null; do
        if [ -x /usr/bin/ss ]; then
            sock=$(/usr/bin/ss -xlHp 2>/dev/null |
                /usr/bin/awk -v p="pid=$comp_pid," 'index($0, p) && $2 == "LISTEN" {print $5; exit}')
        else
            # no iproute2: newest socket created since the compositor started
            sock=$(/usr/bin/find "$XDG_RUNTIME_DIR" -maxdepth 1 -name 'wayland-*' -type s \
                -newer "$stamp" -print -quit 2>/dev/null)
        fi
        if [ -n "$sock" ] && [ -S "$sock" ]; then
            break
        fi
        sock=""
        i=$((i + 1))
        sleep 0.1
    done
    rm -f "$stamp"
}

# Everything needed to understand a black screen on real hardware, written
# to the session log so it survives even when there is no working display.
diagnose_drm() {
    {
        echo "--- Cosmalia DRM diagnostics ---"
        echo "cmdline: $(cat /proc/cmdline 2>/dev/null)"
        echo "DRM cards:"
        for drm in /sys/class/drm/card[0-9]*; do
            [ -e "$drm" ] || continue
            echo "  ${drm##*/}: driver=$(readlink -f "$drm/device/driver" 2>/dev/null) vendor=$(cat "$drm/device/vendor" 2>/dev/null) device=$(cat "$drm/device/device" 2>/dev/null)"
        done
        echo "GPU modules: $(/usr/bin/lsmod 2>/dev/null | /usr/bin/awk '/^(i915|xe|amdgpu|qxl|virtio_gpu|simpledrm|nouveau|radeon)/{printf "%s ",$1}')"
        if [ -x /usr/bin/lspci ]; then
            echo "PCI display devices:"
            /usr/bin/lspci -nnk 2>/dev/null | /usr/bin/grep -A3 -iE 'vga|3d controller|display controller' || true
        fi
        echo "kernel DRM messages:"
        /usr/bin/dmesg 2>/dev/null | /usr/bin/grep -iE 'drm|i915|xe |amdgpu|firmware|simple-framebuffer' | /usr/bin/tail -80 || true
        echo "sessions:"
        /usr/bin/loginctl list-sessions --no-legend 2>/dev/null || true
    } >>"$log" 2>&1
    save_log_to_usb
}

# On the live ISO, keep a copy on the USB's FAT partition: if the screen is
# black, the stick can be moved to another computer and the log read there.
# No-op on an installed system (no ARCHISO_EFI label).
save_log_to_usb() {
    esp=/dev/disk/by-label/ARCHISO_EFI
    [ -e "$esp" ] || return 0
    mnt=/tmp/.cosmalia-esplog
    /usr/bin/sudo -n /bin/mkdir -p "$mnt" 2>/dev/null || return 0
    /usr/bin/sudo -n /bin/mount -t vfat -o rw,umask=000 "$esp" "$mnt" 2>/dev/null || return 0
    /usr/bin/sudo -n /bin/cp "$log" "$mnt/SESSIONLOG.TXT" 2>/dev/null || true
    /usr/bin/sudo -n /bin/umount "$mnt" 2>/dev/null || true
}

# Start the compositor. A slow GPU driver can make the first attempt fail
# before /dev/dri is fully populated, so re-probe and retry a couple of times.
# A compositor that stays alive without opening a socket is killed instead of
# being retried (retrying would not help a hung DRM backend).
attempt=1
comp_status=1
while [ "$attempt" -le 3 ]; do
    probe_drm
    if [ -n "$blocked" ]; then
        export COSMIC_DRM_BLOCK_DEVICES="$blocked"
    else
        unset COSMIC_DRM_BLOCK_DEVICES
    fi
    "$comp" --no-xwayland >>"$log" 2>&1 &
    comp_pid=$!
    : >"$stamp"

    wait_for_socket
    if [ -n "$sock" ]; then
        break
    fi

    if kill -0 "$comp_pid" 2>/dev/null; then
        say "compositor did not open a Wayland socket (attempt $attempt); stopping it"
        kill "$comp_pid" 2>/dev/null || true
        wait "$comp_pid" 2>/dev/null || true
        break
    fi
    wait "$comp_pid" 2>/dev/null
    comp_status=$?
    say "compositor exited without a socket (attempt $attempt, status $comp_status)"
    attempt=$((attempt + 1))
    [ "$attempt" -le 3 ] || break
    say "re-probing DRM and retrying in 2s"
    sleep 2
done

if [ -n "$sock" ]; then
    export WAYLAND_DISPLAY="${sock##*/}"

    # Export additional session identifiers for better app/portal compatibility
    export DESKTOP_SESSION=cosmalia
    export XDG_SESSION_CLASS=user
    if [ -z "${XDG_SESSION_ID:-}" ]; then
        session_id=$(/usr/bin/loginctl show-session "$(/usr/bin/loginctl | /usr/bin/awk -v u="$USER" '$3 == u {print $1; exit}')" -p Id --value 2>/dev/null || true)
        if [ -n "$session_id" ]; then
            export XDG_SESSION_ID="$session_id"
        else
            say "warning: could not resolve XDG_SESSION_ID from loginctl"
        fi
    fi

    # cosmic-comp was started without any display in its environment, so
    # publish ours for portals and other D-Bus/dinit-activated services.
    # No --systemd: there is no systemd user manager here. Without the flag
    # dbus-update-activation-environment still publishes the variables to
    # the session bus, which is what D-Bus-activated portals need.
    /usr/bin/dbus-update-activation-environment \
        WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE \
        XDG_SESSION_ID XDG_SESSION_CLASS DESKTOP_SESSION XDG_RUNTIME_DIR PATH \
        2>/dev/null || true
    # Noctalia and the D-Bus-activated services need the session ID too:
    # without it Noctalia cannot register its polkit agent, so NetworkManager
    # changes fail with "authorization required" and no prompt appears.
    /usr/bin/dinitctl --user setenv \
        WAYLAND_DISPLAY="$WAYLAND_DISPLAY" \
        XDG_CURRENT_DESKTOP="$XDG_CURRENT_DESKTOP" \
        XDG_SESSION_DESKTOP="$XDG_SESSION_DESKTOP" \
        XDG_SESSION_TYPE="$XDG_SESSION_TYPE" \
        XDG_SESSION_ID="${XDG_SESSION_ID:-}" \
        XDG_SESSION_CLASS="${XDG_SESSION_CLASS:-user}" \
        DESKTOP_SESSION="$DESKTOP_SESSION" \
        XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
        PATH="$PATH" 2>/dev/null || true

    # The package installs the session services. Reload in case the user
    # manager survived a package upgrade and still has old definitions cached.
    # `dinitctl reload` needs a service name; new services are loaded on demand
    # by `dinitctl start` anyway.
    for svc in cosmalia-session.target noctalia cosmic-settings-daemon; do
        /usr/bin/dinitctl --user reload "$svc" >>"$log" 2>&1 || true
    done

    # xdg-desktop-portal and its backends are D-Bus activated, not dinit
    # services (the package ships no units named *.service for them), so
    # `dinitctl --user restart` cannot be used. A portal left over from a
    # previous login keeps its old WAYLAND_DISPLAY and its D-Bus name, which
    # means D-Bus will never start a fresh one. Stop the user's portal
    # processes here; D-Bus restarts them on the next request with the
    # activation environment published above.
    /usr/bin/pkill -u "$USER" -f '^/usr/lib/xdg-desktop-portal' \
        >>"$log" 2>&1 || true

    # cosmalia-session.target pulls in noctalia and
    # cosmic-settings-daemon. dinit supervises them from here on:
    # restart on crash, journal logging, and a clean stop with the target.
    if ! /usr/bin/dinitctl --user start cosmalia-session.target >>"$log" 2>&1; then
        say "warning: failed to start cosmalia-session.target; check"
        say "  dinitctl --user status cosmalia-session.target"
        say "  dinitctl --user catlog noctalia"
    fi
    save_log_to_usb

    wait "$comp_pid"
    status=$?
else
    say "compositor socket not found, not starting Noctalia"
    diagnose_drm
    status=${comp_status:-1}
fi

say "compositor exited with status $status"
cleanup
exit "$status"
