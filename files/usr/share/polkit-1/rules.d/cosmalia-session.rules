// Cosmalia session policy.
//
// Noctalia's network widget creates/changes Wi-Fi connections through
// NetworkManager. NM's default policy requires auth_admin for system-wide
// changes, and grants network-control/wifi.scan only to "active" subjects.
//
// In a dinit login the user services run in the `user-1000.userspawn` cgroup,
// not in the logind session cgroup, so polkit reports subject.local/active
// as false even when XDG_SESSION_ID is set. The stock NM rule (and an
// active-only rule) therefore never applies and no polkit agent can answer
// the challenge. Grant local administrators the NM actions by group instead:
// anyone in wheel/sudo is already an admin and can authenticate with sudo.
polkit.addRule(function(action, subject) {
    if (subject.isInGroup("wheel") || subject.isInGroup("sudo")) {
        switch (action.id) {
        case "org.freedesktop.NetworkManager.settings.modify.system":
        case "org.freedesktop.NetworkManager.settings.modify.own":
        case "org.freedesktop.NetworkManager.network-control":
        case "org.freedesktop.NetworkManager.wifi.scan":
        case "org.freedesktop.NetworkManager.enable-disable-wifi":
            return polkit.Result.YES;
        }
    }
});
