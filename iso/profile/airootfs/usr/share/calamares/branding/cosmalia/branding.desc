# Cosmalia branding for the Artix Calamares installer.
# Image assets are copied from Calamares' default branding at ISO build time.
---
componentName: cosmalia

welcomeStyleCalamares: false
welcomeExpandingLogo: true
windowExpanding: normal
windowSize: 1000px,540px
windowPlacement: center
sidebar: widget
navigation: widget

strings:
    productName:         Cosmalia
    shortProductName:    Cosmalia
    version:             Live
    shortVersion:        Live
    versionedName:       Cosmalia Live (Artix)
    shortVersionedName:  Cosmalia
    bootloaderEntryName: Cosmalia

images:
    productLogo:    "squid.png"
    productIcon:    "squid.png"
    productWelcome: "languages.png"

style:
   SidebarBackground:        "#292F34"
   SidebarText:              "#FFFFFF"
   SidebarTextCurrent:       "#292F34"
   SidebarBackgroundCurrent: "#00CED1"

slideshow: "show.qml"
slideshowAPI: 2

uploadServer:
    type: "none"
