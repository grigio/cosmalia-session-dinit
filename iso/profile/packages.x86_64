# --- bootstrap -------------------------------------------------------------
base

# --- Artix kernel, initramfs and keyring ----------------------------------
linux
linux-firmware
intel-ucode
amd-ucode
mkinitcpio
# The live initcpio hooks are vendored from Artix artools, no Arch packages.
artix-keyring
syslinux

# --- dinit userspace (Artix [system] / [world]) ----------------------------
dinit
dinit-base
dinit-rc
userspawn-dinit
elogind-dinit
dbus-dinit
dbus-dinit-user

# --- login manager: greetd + TUI greeter (no cage / no GTK) ----------------
greetd
greetd-dinit
greetd-tuigreet

# --- Cosmalia session (local [cosmalia] repo, built by ../build.sh) --------
cosmalia-session-dinit
# cosmalia-portals.conf pins FileChooser to the cosmic backend; disable its
# D-Bus activation in customize_airootfs.sh (screenshots use the wlr backend).
xdg-desktop-portal-cosmic

# --- GPU rendering / diagnostics -------------------------------------------
# QEMU's QXL card only needs Mesa's software driver, but real AMD/Intel GPUs
# need the i915 / xe / radeonsi DRI drivers shipped by mesa. Pull it in
# explicitly so a dependency change cannot silently drop hardware rendering.
mesa
# lspci -nnk is used by cosmalia-session's DRM diagnostics on real hardware.
pciutils

# --- desktop ---------------------------------------------------------------
# cosmic-comp-traffic (pinned release, local repo) is appended by build.sh;
# it provides/replaces cosmic-comp.
noctalia
cosmic-settings
cosmic-settings-daemon
cosmic-icon-theme
alacritty

# browser line (ungoogled-chromium from Artix galaxy) is appended by build.sh

# --- tools used by the copied cosmic-comp shortcuts ------------------------
playerctl
brightnessctl
grim
slurp
satty

# --- portals / desktop integration -----------------------------------------
xdg-desktop-portal
xdg-desktop-portal-wlr
xdg-desktop-portal-gtk
polkit
gnome-keyring
dbus
pipewire
wireplumber
pipewire-dinit
pipewire-pulse-dinit
wireplumber-dinit

# --- small userspace that makes the live session usable --------------------
adwaita-icon-theme
ttf-dejavu
networkmanager
networkmanager-dinit
wpa_supplicant
wpa_supplicant-dinit
sudo
iproute2
inotify-tools
htop
octopi
# nautilus file manager (GTK4); needs no systemd service.
nautilus
qemu-guest-agent
qemu-guest-agent-dinit

# --- installer: Calamares in offline mode + Limine -------------------------
# Calamares copies this live squashfs to disk (no network, no pacstrap).
# Limine is the bootloader; the upstream Calamares bootloader module does not
# support it, so /usr/local/bin/cosmalia-limine-install does the work instead.
# qt6-wayland provides the Qt Wayland platform plugin for the Calamares GUI.
# dosfstools provides mkfs.fat for the EFI system partition.
# squashfs-tools provides unsquashfs, used by Calamares' unpackfs module.
# rsync copies the live root; os-prober avoids a noisy Calamares warning.
calamares
qt6-wayland
limine
efibootmgr
dosfstools
btrfs-progs
xfsprogs
squashfs-tools
rsync
os-prober

# --- time synchronization (no systemd-timesyncd on Artix/dinit) ------------
# chronyd runs as a dinit service; no .INSTALL hook creates its user/dir, so
# customize_airootfs.sh does that explicitly.
chrony
chrony-dinit
