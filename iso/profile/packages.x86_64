noctalia
cosmic-settings
cosmic-settings-daemon
cosmic-icon-theme
alacritty
# Arch chromium needs libsimdutf.so.37; Artix [world] only ships .so.36, so
# pin this one library from Arch [extra] (satisfies chromium's `simdutf` dep).
extra/simdutf

# browser line (brave-origin or chromium) is appended by build.sh

